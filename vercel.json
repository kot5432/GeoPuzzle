{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/env.js": {
      "includeFiles": ""
    }
  },
  "rewrites": [
    {
      "source": "/env.js",
      "destination": "/api/env"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
