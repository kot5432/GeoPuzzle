{
  "installCommand": "cd artifacts/geo-puzzle && npm install -g pnpm@10.26.1 && pnpm install",
  "buildCommand": "cd artifacts/geo-puzzle && pnpm run build",
  "outputDirectory": "artifacts/geo-puzzle/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
