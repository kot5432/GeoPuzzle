# GeoPuzzle local configuration

# Map data is served from public/maps by Vite.
# The default map file expected by the app is:
#   public/maps/map.pmtiles
#
# No Google Maps Platform API key is required.
# No Google Cloud API key is required.
# Do not configure online map tile URLs for the MVP map implementation.

VITE_PM_TILES_URL=/maps/map.pmtiles
