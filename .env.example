# Google Maps Platform 設定
# 本ファイルは値のひな形です。ローカル開発では下記手順で env.js を生成してください。
#
# 1. .env.local という名前で本ファイルをコピー
# 2. 各値を自分の Google Cloud プロジェクトの値に置き換え
# 3. （任意）付属のスクリプトを使うか手動で env.js を生成:
#    echo "window.__ENV__ = { GOOGLE_MAPS_API_KEY: 'xxx', GOOGLE_MAPS_MAP_ID: 'yyy' };" > env.js
#
# Vercel へのデプロイ時は本ファイルの内容は使用されません。
# Vercel Dashboard → Project Settings → Environment Variables に別途登録してください。

# Maps JavaScript API の APIキー
#  HTTP リファラー制限を必ず付与してください (localhost / *.vercel.app / 本番ドメイン)
VITE_GOOGLE_MAPS_API_KEY=

# Map ID (Vector map 用)
#  Google Cloud Console → Maps → Map Management → Create New Map (JavaScript/Vector)
VITE_GOOGLE_MAPS_MAP_ID=
